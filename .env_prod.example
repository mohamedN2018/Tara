# =============================================================================
# Tara production environment (Dokploy): reference for every variable.
#
# Do not fill this file. Generate the real one, with fresh secrets, by running:
#     ./scripts/gen-dokploy-env.sh [your-domain]      # writes .env_prod (git-ignored)
# then paste .env_prod into Dokploy's Environment tab (docs/deploy/DOKPLOY.md).
#
# Placeholders: REPLACE_ME marks a secret the generator fills. Production
# refuses to boot (manage.py check --deploy) while one survives.
# Lines marked (optional) can be left out: the compose file has the default.
# =============================================================================

# === OWNER MUST FILL =========================================================
# Public hostname with a DNS A record to the server (a *.deplois.net subdomain or your own).
DOMAIN=tara.example.com
# SMTP host. Required: the stack refuses to start while it is empty.
EMAIL_HOST=smtp.example.com
# SMTP port (587 STARTTLS is usual).
EMAIL_PORT=587
# SMTP login user.
EMAIL_HOST_USER=REPLACE_ME
# SMTP login password or app password.
EMAIL_HOST_PASSWORD=REPLACE_ME
# Use STARTTLS.
EMAIL_USE_TLS=true
# (optional) Sender address; empty means no-reply@DOMAIN. The SMTP provider must allow it.
DEFAULT_FROM_EMAIL=no-reply@tara.example.com
# (optional) Server public IPv4 advertised to call clients; empty means STUN discovery.
LIVEKIT_NODE_IP=
# (optional) TURN hostname, DNS-only (grey cloud) in Cloudflare; empty means DOMAIN.
LIVEKIT_TURN_DOMAIN=
# (optional) S3/R2 API endpoint instead of the bundled MinIO, e.g. https://<account>.r2.cloudflarestorage.com.
S3_ENDPOINT_URL=
# (optional) Public base browsers use for presigned media URLs; empty means https://DOMAIN.
S3_PUBLIC_ENDPOINT_URL=
# (optional) S3/R2 access key id; empty means the MinIO root user.
S3_ACCESS_KEY_ID=
# (optional) S3/R2 secret key; empty means the MinIO root password.
S3_SECRET_ACCESS_KEY=
# (optional) Google sign-in OAuth web client id (public); empty turns it off.
GOOGLE_CLIENT_ID=
# (optional) Telegram phone verification bot token; empty turns it off.
TELEGRAM_BOT_TOKEN=
# (optional) Telegram bot username, without @.
TELEGRAM_BOT_USERNAME=

# ---- Runtime -------------------------------------------------------------------
# Informational: the compose file pins TARA_ENV=production (boot-time deploy checks on).
TARA_ENV=production
# Container time zone.
TZ=UTC
# Log level for every service.
LOG_LEVEL=INFO
# Gunicorn workers per HTTP service.
WEB_CONCURRENCY=2
# Compose profiles: "calls" starts the livekit container; empty runs without calls.
COMPOSE_PROFILES=calls
# (optional) Export OpenTelemetry traces.
OTEL_ENABLED=false
# (optional) RabbitMQ topic exchange for domain events.
TARA_EVENT_EXCHANGE=tara.events

# ---- Postgres -------------------------------------------------------------------
# Superuser name (used only by the init script and backups).
POSTGRES_SUPERUSER=tara
# Superuser password.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_ME
# Identity database, role and password.
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=REPLACE_ME
# Profile database, role and password.
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile
PROFILE_DB_PASSWORD=REPLACE_ME
# Social graph database, role and password.
GRAPH_DB_NAME=graph_db
GRAPH_DB_USER=graph
GRAPH_DB_PASSWORD=REPLACE_ME
# Media database, role and password.
MEDIA_DB_NAME=media_db
MEDIA_DB_USER=media
MEDIA_DB_PASSWORD=REPLACE_ME
# Post database, role and password.
POST_DB_NAME=post_db
POST_DB_USER=post
POST_DB_PASSWORD=REPLACE_ME
# Feed database, role and password.
FEED_DB_NAME=feed_db
FEED_DB_USER=feed
FEED_DB_PASSWORD=REPLACE_ME
# Chat database, role and password.
CHAT_DB_NAME=chat_db
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=REPLACE_ME
# Marketplace database, role and password.
MARKET_DB_NAME=market_db
MARKET_DB_USER=market
MARKET_DB_PASSWORD=REPLACE_ME
# Notification database, role and password.
NOTIF_DB_NAME=notif_db
NOTIF_DB_USER=notif
NOTIF_DB_PASSWORD=REPLACE_ME
# Search database, role and password.
SEARCH_DB_NAME=search_db
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=REPLACE_ME
# Moderation database, role and password.
MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=REPLACE_ME
# Admin database, role and password.
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=adminsvc
ADMIN_DB_PASSWORD=REPLACE_ME
# Ads database, role and password.
ADS_DB_NAME=ads_db
ADS_DB_USER=ads
ADS_DB_PASSWORD=REPLACE_ME

# ---- Redis, RabbitMQ, object storage ---------------------------------------------
# Redis password (every service uses its own DB number).
REDIS_PASSWORD=REPLACE_ME
# Feed ranking sessions (redis-hot, 1.7). Derived from REDIS_PASSWORD; set only to override.
# REDIS_HOT_URL=redis://:REPLACE_ME@redis-hot:6379/0
# RabbitMQ user.
RABBITMQ_USER=tara
# RabbitMQ password.
RABBITMQ_PASS=REPLACE_ME
# MinIO root user (held only by minio and media).
MINIO_ROOT_USER=tara
# MinIO root password.
MINIO_ROOT_PASSWORD=REPLACE_ME
# Private media bucket (media creates it on first boot).
S3_BUCKET=tara-media
# Bucket region.
S3_REGION=us-east-1
# Video transcoder's storage user (5.2): minio-init creates it in the bundled
# MinIO, limited to the bucket's videos/ prefix. On S3/R2: a token scoped to videos/.
# (MEDIA_ROLE=transcoder is set by the compose file on media-transcoder only.)
MEDIA_TRANSCODER_S3_ACCESS_KEY=tara-transcoder
# Its secret (36+ random chars).
MEDIA_TRANSCODER_S3_SECRET_KEY=REPLACE_ME

# ---- Video pipeline (5.2 / 5.3) ------------------------------------------------------
# Largest post video, in bytes (nginx's /tara-media/ body limit is 200m).
MEDIA_VIDEO_MAX_BYTES_POST=209715200
# Longest post video, in seconds; longer ones fail with too_long.
MEDIA_VIDEO_MAX_SECONDS_POST=600
# Per account per 24 hours: video uploads, and their total bytes.
MEDIA_VIDEO_DAILY_UPLOADS=20
MEDIA_VIDEO_DAILY_BYTES=2147483648
# Top of the HLS ladder (240/360/480/720); never above the source.
MEDIA_VIDEO_MAX_HEIGHT=720
# HDR sources: tonemap (to SDR) or reject (fails with hdr_unsupported).
MEDIA_VIDEO_HDR_MODE=tonemap
# Also make a 480p progressive MP4 (more CPU and storage).
MEDIA_VIDEO_MP4_FALLBACK=false
# Keep the original upload after a successful transcode (never served).
MEDIA_KEEP_VIDEO_ORIGINALS=false
# Each ffmpeg step is killed after this many seconds (fails with timeout).
MEDIA_TRANSCODE_STEP_TIMEOUT=1200
# Transcoder tuning: frame-rate cap, largest source frame (pixels), ffmpeg
# threads and address-space limit (MB), scratch dir, and the media.transcode
# queue consumer timeout (ms; media and the transcoder must use the same value).
MEDIA_VIDEO_MAX_FPS=30
MEDIA_VIDEO_MAX_PIXELS=8294400
MEDIA_FFMPEG_THREADS=2
MEDIA_FFMPEG_MAX_MEMORY_MB=1200
MEDIA_TRANSCODE_SCRATCH_DIR=/tmp/tara-transcode
MEDIA_TRANSCODE_CONSUMER_TIMEOUT_MS=7200000
# Signs HLS playlist tokens (64 hex chars). Empty: derived from MEDIA_SECRET_KEY.
MEDIA_PLAYBACK_SECRET=REPLACE_ME
# Playlist token lifetime, seconds.
MEDIA_PLAYBACK_TOKEN_TTL=3600
# Segment URLs expire within this many seconds: a removed video stops within it.
MEDIA_HLS_URL_WINDOW_SECONDS=300
# How long media caches post's "may this viewer see it" answer for playlists.
MEDIA_PLAYBACK_ACCESS_CACHE_SECONDS=30

# ---- Django secret keys (one per service, 64 hex chars each) ------------------------
IDENTITY_SECRET_KEY=REPLACE_ME
PROFILE_SECRET_KEY=REPLACE_ME
GRAPH_SECRET_KEY=REPLACE_ME
MEDIA_SECRET_KEY=REPLACE_ME
POST_SECRET_KEY=REPLACE_ME
FEED_SECRET_KEY=REPLACE_ME
CHAT_SECRET_KEY=REPLACE_ME
REALTIME_SECRET_KEY=REPLACE_ME
MARKETPLACE_SECRET_KEY=REPLACE_ME
NOTIFICATION_SECRET_KEY=REPLACE_ME
SEARCH_SECRET_KEY=REPLACE_ME
MODERATION_SECRET_KEY=REPLACE_ME
ADMIN_SECRET_KEY=REPLACE_ME
ADS_SECRET_KEY=REPLACE_ME

# ---- Internal and caller-specific secrets ---------------------------------------------
# Service-to-service token secret (every service).
INTERNAL_JWT_SECRET=REPLACE_ME
# Identity and admin only, 32+ chars, different from INTERNAL_JWT_SECRET (1.0d).
ADMIN_IDENTITY_SECRET=REPLACE_ME
# Ads only: signs ad serve tokens.
ADS_SERVE_TOKEN_SECRET=REPLACE_ME
# Telegram webhook secret (A-Z a-z 0-9 _ -, 32+ chars).
TELEGRAM_WEBHOOK_SECRET=REPLACE_ME

# ---- User tokens (RS256) ---------------------------------------------------------------
# Token issuer claim.
JWT_ISSUER=tara-identity
# Token audience claim.
JWT_AUDIENCE=tara
# Key id published in the JWKS.
IDENTITY_JWT_KEY_ID=prod-key-1
# (optional) PKCS#8 private key, one line with literal \n; empty means generate once into the identity-keys volume.
IDENTITY_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----
# (optional) Matching public key, one line with literal \n.
IDENTITY_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----
# Access token lifetime in seconds (15 min).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds (30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000
# Seconds a just-spent refresh token may be replayed (lost response) without revoking the session; 0 disables.
REFRESH_REUSE_GRACE_SECONDS=20

# ---- DEBUG (must stay false) ------------------------------------------------------------
IDENTITY_DEBUG=false
PROFILE_DEBUG=false
GRAPH_DEBUG=false
MEDIA_DEBUG=false
POST_DEBUG=false
FEED_DEBUG=false
CHAT_DEBUG=false
REALTIME_DEBUG=false
MARKETPLACE_DEBUG=false
NOTIFICATION_DEBUG=false
SEARCH_DEBUG=false
MODERATION_DEBUG=false
ADMIN_DEBUG=false
ADS_DEBUG=false

# ---- Hosts and origins (optional overrides; leave commented) ---------------------------------
# Allowed hosts default to DOMAIN,<service>,localhost,127.0.0.1. Never "*" in production.
# IDENTITY_ALLOWED_HOSTS=tara.example.com,identity,localhost,127.0.0.1
# PROFILE_ALLOWED_HOSTS=tara.example.com,profile,localhost,127.0.0.1
# GRAPH_ALLOWED_HOSTS=tara.example.com,graph,localhost,127.0.0.1
# MEDIA_ALLOWED_HOSTS=tara.example.com,media,localhost,127.0.0.1
# POST_ALLOWED_HOSTS=tara.example.com,post,localhost,127.0.0.1
# FEED_ALLOWED_HOSTS=tara.example.com,feed,localhost,127.0.0.1
# CHAT_ALLOWED_HOSTS=tara.example.com,chat,localhost,127.0.0.1
# MARKETPLACE_ALLOWED_HOSTS=tara.example.com,marketplace,localhost,127.0.0.1
# NOTIFICATION_ALLOWED_HOSTS=tara.example.com,notification,localhost,127.0.0.1
# SEARCH_ALLOWED_HOSTS=tara.example.com,search,localhost,127.0.0.1
# MODERATION_ALLOWED_HOSTS=tara.example.com,moderation,localhost,127.0.0.1
# ADMIN_ALLOWED_HOSTS=tara.example.com,admin,localhost,127.0.0.1
# ADS_ALLOWED_HOSTS=tara.example.com,ads,localhost,127.0.0.1
# REALTIME_ALLOWED_HOSTS=tara.example.com,realtime,localhost,127.0.0.1
# CORS origins default to https://DOMAIN (the SPA is same-origin). Realtime has none.
# IDENTITY_CORS_ORIGINS=https://tara.example.com
# PROFILE_CORS_ORIGINS=https://tara.example.com
# GRAPH_CORS_ORIGINS=https://tara.example.com
# MEDIA_CORS_ORIGINS=https://tara.example.com
# POST_CORS_ORIGINS=https://tara.example.com
# FEED_CORS_ORIGINS=https://tara.example.com
# CHAT_CORS_ORIGINS=https://tara.example.com
# MARKETPLACE_CORS_ORIGINS=https://tara.example.com
# NOTIFICATION_CORS_ORIGINS=https://tara.example.com
# SEARCH_CORS_ORIGINS=https://tara.example.com
# MODERATION_CORS_ORIGINS=https://tara.example.com
# ADMIN_CORS_ORIGINS=https://tara.example.com
# ADS_CORS_ORIGINS=https://tara.example.com

# ---- Rate limits (production defaults) ------------------------------------------------------
# Sign-ups per IP.
AUTH_REGISTER_RATE=10/hour
# Login attempts per IP.
AUTH_LOGIN_RATE=20/min
# Login attempts per targeted email, any IP.
AUTH_LOGIN_TARGET_RATE=10/min
# Password reset/change requests per IP.
AUTH_PASSWORD_RATE=5/hour
# Post and comment reports per account.
POST_REPORT_RATE=20/hour
# Group reports per account.
GROUP_REPORT_RATE=20/hour
# Sign-up handle availability checks per client address.
PROFILE_HANDLE_CHECK_RATE=30/min
# Reports filed through moderation per account.
MODERATION_REPORT_RATE=20/hour
# Per-user API reads, every service.
TARA_READ_RATE=600/min
# Per-user API writes, every service.
TARA_WRITE_RATE=120/min
# Calls started per user.
CALL_START_RATE=20/min
# (optional) Audit-log exports per staff member.
ADMIN_AUDIT_EXPORT_RATE=10/min
# (optional) PII reveals per staff member in the user console.
ADMIN_USER_REVEAL_RATE=30/hour

# ---- Moderation and ads gates ------------------------------------------------------------------
# New listings wait for a moderator.
MARKETPLACE_AUTO_APPROVE=false
# New ads wait for a moderator.
ADS_AUTO_APPROVE=false
# Paid ads stay off until payment verification exists (ads refuses to boot with true).
ADS_SERVING_ENABLED=false

# ---- Event flags (fresh install: true; upgrades: see DOKPLOY.md) ---------------------------------
# Role and capability audit events for admin's log (8.1).
IDENTITY_EMIT_AUDIT_EVENTS=true
# appeal.resolved audit events (8.1).
MODERATION_EMIT_AUDIT_EVENTS=true
# Suspension, sign-out and verification-resent events (8.4, 8.6).
IDENTITY_EMIT_ACCOUNT_ACTION_EVENTS=true
# page.updated for search v2 (1.15).
PROFILE_EMIT_PAGE_UPDATED=true
# group.* events (1.11).
PROFILE_EMIT_GROUP_EVENTS=true
# Group post events (1.11).
POST_EMIT_GROUP_EVENTS=true
# post.tagged, so tagged people are notified (plan 08 track 2C).
POST_EMIT_TAG_EVENTS=true
# relationship.muted/unmuted/favorited/unfavorited for feed (plan 08 track 2D).
GRAPH_EMIT_MUTE_FAVORITE_EVENTS=true
# relationship.restricted/unrestricted (plan 08 track 2D).
GRAPH_EMIT_RESTRICT_EVENTS=true

# ---- Registration (track 1D) ---------------------------------------------------------------------
# Terms version a new account accepts.
LEGAL_TERMS_VERSION=2026-11-04-draft
# Privacy policy version a new account accepts.
LEGAL_PRIVACY_VERSION=2026-11-04-draft
# Minimum self-declared age to register (13, 16 or 18 per market).
REGISTRATION_MIN_AGE=13
# (optional) Identity's timeout for profile handle lookups, in seconds.
PROFILE_CALL_TIMEOUT=2

# ---- Web Push (VAPID) -------------------------------------------------------------------------------
# Public key, base64url raw P-256 point. Replacing it drops every push subscription.
VAPID_PUBLIC_KEY=REPLACE_ME
# Private key, base64url raw P-256 scalar.
VAPID_PRIVATE_KEY=REPLACE_ME
# (optional) Contact for push services; default mailto:admin@DOMAIN.
VAPID_SUBJECT=mailto:admin@tara.example.com

# ---- Calls (LiveKit) ------------------------------------------------------------------------------------
# API key shared by chat and livekit; empty key or secret turns calls off.
LIVEKIT_API_KEY=REPLACE_ME
# API secret, 32+ chars; signs join tokens and webhooks.
LIVEKIT_API_SECRET=REPLACE_ME
# (optional) URL browsers connect to; default wss://DOMAIN (the edge proxies /rtc).
LIVEKIT_URL=wss://tara.example.com
# (optional) Chat's server-side LiveKit API.
LIVEKIT_INTERNAL_URL=http://livekit:7880
# (optional) Use LiveKit's built-in TURN on UDP 3478.
LIVEKIT_TURN_ENABLED=true
# (optional) Seconds chat waits for the LiveKit API.
LIVEKIT_API_TIMEOUT=3
# (optional) Unanswered calls become missed after this many seconds.
CALL_RING_TIMEOUT_SECONDS=45
# (optional) Join token lifetime in seconds (capped at 600).
CALL_TOKEN_TTL_SECONDS=600
# (optional) Participants per call.
CALL_MAX_PARTICIPANTS=16
# (optional) Ask LiveKit about quiet active calls after this many seconds.
CALL_RECONCILE_AFTER_SECONDS=120

# ---- Service tuning (all optional; values are the defaults) -----------------------------------------
# How often identity-worker lifts expired suspensions, in seconds.
IDENTITY_SUSPENSION_EXPIRY_SECONDS=60
# Search's timeout for owner-service lookups, in seconds.
SEARCH_INTERNAL_TIMEOUT=1.5
# Realtime: how long a block is remembered for presence, in seconds.
PRESENCE_BLOCK_MEMORY_TTL=3600
# Marketplace: an inquiry must be this old (seconds) before the buyer can review.
MARKETPLACE_REVIEW_MIN_INQUIRY_AGE_SECONDS=86400
# Marketplace: days a seller can reply to a review.
MARKETPLACE_REVIEW_SELLER_WINDOW_DAYS=30
# Admin: BFF readiness URL; empty because the Dokploy stack has no BFF.
ADMIN_BFF_READY_URL=
# Admin: service health poll interval, in seconds.
ADMIN_HEALTH_POLL_SECONDS=30
# Admin: health snapshots kept per service.
ADMIN_HEALTH_SNAPSHOTS_KEPT=500
# Admin: platform statistics poll interval, in seconds.
ADMIN_STATS_POLL_SECONDS=300
# Admin: per-service statistics timeout, in seconds.
ADMIN_STATS_TIMEOUT=5
# Admin: rows per audit-log export.
ADMIN_AUDIT_EXPORT_MAX_ROWS=10000
# Admin: timeout for user-console calls to other services, in seconds.
ADMIN_USERS_CALL_TIMEOUT=3
