# =============================================================================
# Tara — example environment. Copy to `.env` and adjust. NEVER commit `.env`.
# =============================================================================
# Phase 1 brings up: Postgres, Redis, RabbitMQ, MinIO, Mailpit, Identity, BFF,
# Traefik, and the observability stack. Most defaults work out of the box.

# ---- Global ----------------------------------------------------------------
TARA_ENV=development          # development | staging | production
TZ=UTC
COMPOSE_PROJECT_NAME=tara

# ---- PostgreSQL (one server, one logical DB per service) --------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=tara
POSTGRES_SUPERUSER_PASSWORD=change-me-in-dev
# Per-service DBs are created by infra/postgres/init/01-create-databases.sql

# Identity service DB
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity-dev-pass

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- RabbitMQ (events + Celery broker) --------------------------------------
RABBITMQ_DEFAULT_USER=tara
RABBITMQ_DEFAULT_PASS=tara-dev-pass
RABBITMQ_URL=amqp://tara:tara-dev-pass@rabbitmq:5672//
TARA_EVENT_EXCHANGE=tara.events

# ---- Object storage (MinIO in dev, S3 in prod) ------------------------------
MINIO_ROOT_USER=tara
MINIO_ROOT_PASSWORD=tara-dev-pass
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Mail (Mailpit in dev) --------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@tara.local

# ---- Identity service -------------------------------------------------------
# Django secret — generate a strong value; NEVER reuse across environments.
IDENTITY_SECRET_KEY=dev-only-insecure-secret-change-me
IDENTITY_DEBUG=true
IDENTITY_ALLOWED_HOSTS=*
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT signing keypair (RS256). In dev these are auto-generated on first boot if
# left empty (see entrypoint). In prod, inject via secret manager (PEM strings,
# newlines escaped as \n or mounted as files).
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=
IDENTITY_JWT_KEY_ID=dev-key-1
ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days
JWT_ISSUER=tara-identity
JWT_AUDIENCE=tara

# Internal service-to-service token signing (separate from user tokens)
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me

# ---- BFF --------------------------------------------------------------------
BFF_IDENTITY_BASE_URL=http://identity:8000
BFF_JWKS_URL=http://identity:8000/.well-known/jwks.json
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Observability ----------------------------------------------------------
OTEL_ENABLED=false                      # set true to export traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=identity
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console
