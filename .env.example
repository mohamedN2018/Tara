# =============================================================================
# Tara — example environment. Copy to `.env` and adjust. NEVER commit `.env`.
# Production (Dokploy): see .env_prod.example and scripts/gen-dokploy-env.sh.
# =============================================================================
# Phase 1 brings up: Postgres, Redis, RabbitMQ, MinIO, Mailpit, Identity, BFF,
# Traefik, and the observability stack. Most defaults work out of the box.

# ---- Global ----------------------------------------------------------------
TARA_ENV=development          # development | staging | production
TZ=UTC
COMPOSE_PROJECT_NAME=tara

# ---- PostgreSQL (one server, one logical DB per service) --------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=tara
POSTGRES_SUPERUSER_PASSWORD=change-me-in-dev
# Per-service DBs are created by infra/postgres/init/01-create-databases.sh

# Identity service DB
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity-dev-pass

# Profile service DB
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile
PROFILE_DB_PASSWORD=profile-dev-pass

# Social Graph service DB
GRAPH_DB_NAME=graph_db
GRAPH_DB_USER=graph
GRAPH_DB_PASSWORD=graph-dev-pass

# Media / Post / Feed service DBs (Phase 3)
MEDIA_DB_NAME=media_db
MEDIA_DB_USER=media
MEDIA_DB_PASSWORD=media-dev-pass
POST_DB_NAME=post_db
POST_DB_USER=post
POST_DB_PASSWORD=post-dev-pass
FEED_DB_NAME=feed_db
FEED_DB_USER=feed
FEED_DB_PASSWORD=feed-dev-pass

# Chat service DB (Phase 4); Realtime gateway has no DB
CHAT_DB_NAME=chat_db
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=chat-dev-pass

# Marketplace service DB (Phase 5)
MARKET_DB_NAME=market_db
MARKET_DB_USER=market
MARKET_DB_PASSWORD=market-dev-pass

# Notifications / Search / Moderation / Admin service DBs (Phase 6)
NOTIF_DB_NAME=notif_db
NOTIF_DB_USER=notif
NOTIF_DB_PASSWORD=notif-dev-pass
SEARCH_DB_NAME=search_db
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=search-dev-pass
MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=moderation-dev-pass
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=adminsvc
ADMIN_DB_PASSWORD=admin-dev-pass

# Advertisement service DB (Phase 7)
ADS_DB_NAME=ads_db
ADS_DB_USER=ads
ADS_DB_PASSWORD=ads-dev-pass

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Feed ranking sessions (1.7): a separate Redis with its own maxmemory and noeviction.
REDIS_HOT_URL=redis://redis-hot:6379/0

# ---- RabbitMQ (events + Celery broker) --------------------------------------
RABBITMQ_DEFAULT_USER=tara
RABBITMQ_DEFAULT_PASS=tara-dev-pass
RABBITMQ_URL=amqp://tara:tara-dev-pass@rabbitmq:5672//
TARA_EVENT_EXCHANGE=tara.events

# ---- Object storage (MinIO in dev, S3 in prod) ------------------------------
MINIO_ROOT_USER=tara
MINIO_ROOT_PASSWORD=tara-dev-pass
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Mail (Mailpit in dev) --------------------------------------------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@tara.local

# ---- Identity service -------------------------------------------------------
# Django secret — generate a strong value; NEVER reuse across environments.
IDENTITY_SECRET_KEY=dev-only-insecure-secret-change-me
IDENTITY_DEBUG=true
IDENTITY_ALLOWED_HOSTS=*
IDENTITY_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT signing keypair (RS256). In dev these are auto-generated on first boot if
# left empty (see entrypoint). In prod, inject via secret manager (PEM strings,
# newlines escaped as \n or mounted as files).
IDENTITY_JWT_PRIVATE_KEY=
IDENTITY_JWT_PUBLIC_KEY=
IDENTITY_JWT_KEY_ID=dev-key-1
ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days
REFRESH_REUSE_GRACE_SECONDS=20          # a lost refresh response (tab closed mid-refresh) may be replayed this long without ending the session; 0 = off
JWT_ISSUER=tara-identity
JWT_AUDIENCE=tara

# Internal service-to-service token signing (separate from user tokens)
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me
# Held ONLY by identity and admin: signs admin's calls to identity's internal
# role/staff API, which refuses INTERNAL_JWT_SECRET (roadmap 1.0d). Required in
# production (32+ chars, different from INTERNAL_JWT_SECRET).
ADMIN_IDENTITY_SECRET=dev-only-admin-identity-secret-change-me
# Held ONLY by identity and chat: signs chat's call to identity's internal
# capability-holders list (who answers the support inbox). Required in
# production (32+ chars, different from INTERNAL_JWT_SECRET).
CHAT_IDENTITY_SECRET=dev-only-chat-identity-secret-change-me

# Two-factor sign-in (settings centre, 3C). Key for the TOTP secrets at rest;
# empty derives one from IDENTITY_SECRET_KEY (openssl rand -hex 32 in production).
IDENTITY_TOTP_ENCRYPTION_KEY=
# true: staff roles reach the token only once the account has turned on 2FA.
IDENTITY_STAFF_REQUIRE_2FA=false

# Google sign-in (off when empty). The OAuth *web* client id from Google Cloud
# Console; it is public. Add the site origin to its "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Telegram phone verification (off unless all three are set). Bot from @BotFather;
# the secret is 32+ chars of A-Z a-z 0-9 _ - (openssl rand -hex 32). Register the
# webhook with: python manage.py set_telegram_webhook --url https://<your-domain>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- Profile & Social Graph services (Phase 2) ------------------------------
PROFILE_SECRET_KEY=dev-only-insecure-secret-change-me
PROFILE_DEBUG=true
GRAPH_SECRET_KEY=dev-only-insecure-secret-change-me
GRAPH_DEBUG=true
# Other services verify user tokens via Identity's JWKS:
TARA_JWKS_URL=http://identity:8000/.well-known/jwks.json
# Profile resolves friends_only privacy via the Graph internal API:
GRAPH_INTERNAL_URL=http://graph:8000
# Post checks and restricts attached media; media asks post who may see
# restricted (non-public post) media. Optional: these are the defaults.
# MEDIA_INTERNAL_URL=http://media:8000
# POST_INTERNAL_URL=http://post:8000
# Feed's and graph's intelligence backfills read identity's and moderation's
# internal exports (WP 3.3). Optional: these are the defaults.
# IDENTITY_INTERNAL_URL=http://identity:8000
# MODERATION_INTERNAL_URL=http://moderation:8000

# ---- Media / Post / Feed services (Phase 3) ---------------------------------
MEDIA_SECRET_KEY=dev-only-insecure-secret-change-me
POST_SECRET_KEY=dev-only-insecure-secret-change-me
FEED_SECRET_KEY=dev-only-insecure-secret-change-me
CHAT_SECRET_KEY=dev-only-insecure-secret-change-me
REALTIME_SECRET_KEY=dev-only-insecure-secret-change-me
MARKETPLACE_SECRET_KEY=dev-only-insecure-secret-change-me
MARKETPLACE_AUTO_APPROVE=true
NOTIFICATION_SECRET_KEY=dev-only-insecure-secret-change-me
SEARCH_SECRET_KEY=dev-only-insecure-secret-change-me
MODERATION_SECRET_KEY=dev-only-insecure-secret-change-me
ADMIN_SECRET_KEY=dev-only-insecure-secret-change-me
ADS_SECRET_KEY=dev-only-insecure-secret-change-me
ADS_AUTO_APPROVE=false
# Signs the ad serve tokens browsers hold; ads-only, never INTERNAL_JWT_SECRET.
# Required in production. Empty in dev: ads derives a dev key and warns.
ADS_SERVE_TOKEN_SECRET=dev-only-ads-serve-token-secret-change-me
# ---- Tara Intelligence (feed) -------------------------------------------------
# Signs the serve tokens that attribute telemetry; feed-only, never FEED_SECRET_KEY
# or INTERNAL_JWT_SECRET. Required in production; unset in dev derives a key and warns.
INTEL_SERVE_TOKEN_SECRET=dev-only-intel-serve-token-secret-change-me
# Seed (seed-*) and test (test-*) accounts in intel_synthetic_account: their rows are
# stored as synthetic/test only when true. Production: false, and the table empty.
INTEL_ACCEPT_SYNTHETIC=true
# Dev only: synthetic actors still move post_stats / affinity (the dev data is all seed).
INTEL_SYNTHETIC_IN_RANKING=true
# Raw telemetry retention in days (owner decision: 30; dev keeps 90 for the 60-day
# synthetic history). Per-user-item engagement: 7 to 30 days.
INTEL_SIGNAL_RETENTION_DAYS=90
INTEL_ENGAGEMENT_RETENTION_DAYS=30
# Emit intel.config.changed (admin audit log) on ranking config changes (WP 4.1).
INTEL_EMIT_CONFIG_CHANGED=true
# Dev only (WP 4b.15): honour the X-Tara-Test-Now header for seed and test accounts
# (feed ranking "now" and feed-signals received_at). Refused outside development.
INTEL_TEST_CLOCK_ENABLED=false
# Unset: ads serve in dev, and not when TARA_ENV=production (no payment
# verification yet; the deploy check refuses to boot production with it on).
# ADS_SERVING_ENABLED=
# Feed blends sponsored slots from Ads (degrades to organic if Ads is down):
ADS_INTERNAL_URL=http://ads:8000
# Search: OpenSearch is optional (Postgres is the fallback + source of truth)
SEARCH_USE_OPENSEARCH=false
OPENSEARCH_URL=http://opensearch:9200
# Media object storage (MinIO in dev)
TARA_STORAGE_BACKEND=s3
S3_BUCKET=tara-media
S3_PUBLIC_BASE=http://localhost:9000
# Video pipeline (5.2 / 5.3). The media-transcoder container gets only its own
# variables (no env_file); minio-init creates its videos/-only MinIO user.
# MEDIA_ROLE=transcoder is set by compose on media-transcoder only; never set it here.
MEDIA_TRANSCODER_S3_ACCESS_KEY=tara-transcoder
MEDIA_TRANSCODER_S3_SECRET_KEY=tara-transcoder-dev-pass
MEDIA_VIDEO_MAX_BYTES_POST=209715200
MEDIA_VIDEO_MAX_SECONDS_POST=600
MEDIA_VIDEO_DAILY_UPLOADS=200
MEDIA_VIDEO_DAILY_BYTES=21474836480
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_HDR_MODE=tonemap
MEDIA_VIDEO_MP4_FALLBACK=false
MEDIA_KEEP_VIDEO_ORIGINALS=false
MEDIA_TRANSCODE_STEP_TIMEOUT=1200
# Transcoder tuning (the media.transcode queue argument must match in media and the transcoder).
MEDIA_VIDEO_MAX_FPS=30
MEDIA_VIDEO_MAX_PIXELS=8294400
MEDIA_FFMPEG_THREADS=2
MEDIA_FFMPEG_MAX_MEMORY_MB=1200
MEDIA_TRANSCODE_SCRATCH_DIR=/tmp/tara-transcode
MEDIA_TRANSCODE_CONSUMER_TIMEOUT_MS=7200000
# Empty: derived from MEDIA_SECRET_KEY.
MEDIA_PLAYBACK_SECRET=
MEDIA_PLAYBACK_TOKEN_TTL=3600
MEDIA_HLS_URL_WINDOW_SECONDS=300
MEDIA_PLAYBACK_ACCESS_CACHE_SECONDS=30
# Display URLs (images, thumbnails, display sizes, posters) are signed per bucket of
# this many seconds, so browsers cache them (Tara Intelligence WP 4c.5-B3).
MEDIA_DISPLAY_URL_BUCKET_SECONDS=3600

# ---- BFF --------------------------------------------------------------------
BFF_IDENTITY_BASE_URL=http://identity:8000
BFF_JWKS_URL=http://identity:8000/.well-known/jwks.json
BFF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Observability ----------------------------------------------------------
OTEL_ENABLED=false                      # set true to export traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=identity
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console

# ---- Dev only: DEBUG is off and hosts are pinned unless set here -------------
MEDIA_DEBUG=true
MEDIA_ALLOWED_HOSTS=*
POST_DEBUG=true
POST_ALLOWED_HOSTS=*
FEED_DEBUG=true
FEED_ALLOWED_HOSTS=*
CHAT_DEBUG=true
CHAT_ALLOWED_HOSTS=*
REALTIME_DEBUG=true
REALTIME_ALLOWED_HOSTS=*
MARKETPLACE_DEBUG=true
MARKETPLACE_ALLOWED_HOSTS=*
NOTIFICATION_DEBUG=true
NOTIFICATION_ALLOWED_HOSTS=*
SEARCH_DEBUG=true
SEARCH_ALLOWED_HOSTS=*
MODERATION_DEBUG=true
MODERATION_ALLOWED_HOSTS=*
ADMIN_DEBUG=true
ADMIN_ALLOWED_HOSTS=*
ADS_DEBUG=true
ADS_ALLOWED_HOSTS=*
PROFILE_ALLOWED_HOSTS=*
GRAPH_ALLOWED_HOSTS=*

# gunicorn workers per service
WEB_CONCURRENCY=2

# Dev: tests register many users from one address
AUTH_REGISTER_RATE=1000/hour
AUTH_LOGIN_RATE=1000/min
# Login attempts per targeted email (any IP). Production default: 10/min.
AUTH_LOGIN_TARGET_RATE=1000/min
AUTH_PASSWORD_RATE=1000/hour
# 2FA setup/disable, recovery codes, deactivate and delete, per account. Production default: 30/hour.
ACCOUNT_SECURITY_RATE=1000/hour
# Post and comment reports per account. Production default: 20/hour.
POST_REPORT_RATE=1000/hour
# Group reports per account. Production default: 20/hour.
GROUP_REPORT_RATE=1000/hour
# Sign-up's public handle check (profile), per client address. Production default: 30/min.
PROFILE_HANDLE_CHECK_RATE=1000/min
# ---- Registration (identity, plan 08 track 1D) -------------------------------
# Terms and privacy versions a sign-up must accept. They must equal TERMS_VERSION
# and PRIVACY_VERSION in frontend/web/src/lib/legal.ts; bump them together.
LEGAL_TERMS_VERSION=2026-11-04-draft
LEGAL_PRIVACY_VERSION=2026-11-04-draft
# Minimum self-declared age at sign-up (roadmap §21 decision 5). Default 13.
REGISTRATION_MIN_AGE=13
# ---- Graph: mute, favorites, restrict (plan 08 track 2D) ---------------------
# relationship.muted/unmuted/favorited/unfavorited for feed. Default true.
GRAPH_EMIT_MUTE_FAVORITE_EVENTS=true
# relationship.restricted/unrestricted (post consumes them later). Default true.
GRAPH_EMIT_RESTRICT_EVENTS=true
# ---- Chat: message requests and message reports (plan 08 T5) -----------------
# A DM a non-friend starts lands in the recipient's message requests. Default true.
CHAT_MESSAGE_REQUESTS=true
# message.reported for moderation (moderation already consumes it). Default true.
CHAT_EMIT_MESSAGE_REPORTED=true
# A member's message to Tara Support notifies the support team (holders of
# moderation.case.view, asked from identity). Default true.
CHAT_NOTIFY_SUPPORT_TEAM=true
# ---- Admin: administrative notices (plan 08 T7) --------------------------------
# system.notice from the console's Announcements section (notification consumes it). Default true.
ADMIN_EMIT_SYSTEM_NOTICES=true
# ---- Post: the composer (plan 08 track 2C) -------------------------------------
# post.tagged, so people tagged in a post are notified (post.tag). Default true.
POST_EMIT_TAG_EVENTS=true
# Stories (1.9): story.reacted (notification), story.reported (moderation) and
# story.deleted (notification purge). Default true.
POST_EMIT_STORY_EVENTS=true
# post.hidden / post.unhidden on account deactivation and reactivation (3C).
POST_EMIT_HIDE_EVENTS=true
# post.saved / post.unsaved, ids only, for feed (Tara Intelligence WP 2.6, owner decision 6).
POST_EMIT_SAVE_EVENTS=true
# Reels for_you: reels the viewer watched in the last N hours go after the unwatched
# ones (Tara Intelligence WP 4b.9). Integer hours, 1 to 720, default 72.
REELS_SEEN_WINDOW_H=72
# moderation.actioned with action=reinstate when an appeal overturns a user's or
# page's restrict/shadow (Tara Intelligence WP 3.3b; graph consumes it). Default true.
MODERATION_EMIT_REINSTATE=true
# Per-user API limits in every service. Production defaults: 600/min reads,
# 120/min writes. e2e drives a few shared accounts hard, so dev raises them.
TARA_READ_RATE=10000/min
TARA_WRITE_RATE=5000/min
# Web Push. Generate with: python -m py_vapid --gen (leave empty to turn push off)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# ---- Calls (LiveKit, roadmap 3.7) --------------------------------------------
# Chat turns calls on only when the key and the secret are both set; empty means
# every call endpoint answers 503 calls_unavailable and the UI hides call buttons.
# These dev values match the livekit container's defaults (infra/compose).
# The secret must be at least 32 characters.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-change-me-0123456789
# The ws URL the browser connects to (the edge routes /rtc to livekit:7880).
LIVEKIT_URL=ws://localhost:8080
# Server-side API (remove a participant, close a room).
LIVEKIT_INTERNAL_URL=http://livekit:7880
