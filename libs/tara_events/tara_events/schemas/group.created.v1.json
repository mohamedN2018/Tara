{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/group.created.v1.json",
  "title": "group.created v1 payload",
  "description": "A group was created; its creator is the owner. Search indexes {group_id, handle, name, privacy, category}; a hidden group has a blank name and handle and privacy hidden, so search drops it. post reads post_approval and status into its group read model.",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "format": "uuid"
    },
    "handle": {
      "type": "string",
      "maxLength": 30,
      "description": "Blank for a hidden group."
    },
    "name": {
      "type": "string",
      "maxLength": 100,
      "description": "Blank for a hidden group."
    },
    "privacy": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "hidden"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "education",
        "business",
        "technology",
        "sports",
        "gaming",
        "arts",
        "entertainment",
        "health",
        "travel",
        "food",
        "parenting",
        "religion",
        "local",
        "buy_sell",
        "hobbies",
        "science",
        "other"
      ]
    },
    "post_approval": {
      "type": "boolean"
    },
    "membership_approval": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ]
    }
  },
  "required": [
    "group_id",
    "handle",
    "name",
    "privacy",
    "category"
  ],
  "additionalProperties": false
}
