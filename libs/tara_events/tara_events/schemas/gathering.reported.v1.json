{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/gathering.reported.v1.json",
  "title": "gathering.reported v1 payload",
  "description": "An account reported an event it can see; once per reporter per event. reason is an enum, owner_id the host.",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string",
      "format": "uuid"
    },
    "reporter": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "scam",
        "hate",
        "violence",
        "nudity",
        "harassment",
        "false_information",
        "other"
      ]
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "gathering_id",
    "reporter",
    "reason",
    "owner_id"
  ],
  "additionalProperties": false
}
