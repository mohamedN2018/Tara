{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/post.saved.v1.json",
  "title": "post.saved v1 payload",
  "description": "The account saved a post it may see (Tara Intelligence WP 2.6, owner decision 6). Ids only: neither the collection id nor its name is ever sent. Consumed by feed only. Behind POST_EMIT_SAVE_EVENTS. partition_key = account:<id>.",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "author_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "post",
        "video"
      ]
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "post_id",
    "account_id",
    "author_id",
    "saved_at"
  ],
  "additionalProperties": false
}
