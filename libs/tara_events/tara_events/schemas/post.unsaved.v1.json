{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/post.unsaved.v1.json",
  "title": "post.unsaved v1 payload",
  "description": "The account removed a saved post (Tara Intelligence WP 2.6). Emitted only when a save row was really removed. Ids only. Behind POST_EMIT_SAVE_EVENTS.",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "type": "string",
      "format": "uuid"
    },
    "author_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "post",
        "video"
      ]
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "post_id",
    "account_id",
    "author_id",
    "saved_at"
  ],
  "additionalProperties": false
}
