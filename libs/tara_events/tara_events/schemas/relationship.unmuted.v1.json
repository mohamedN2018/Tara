{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/relationship.unmuted.v1.json",
  "title": "relationship.unmuted v1 payload",
  "description": "The actor unmuted the target. Emitted only when a mute actually went away. Behind GRAPH_EMIT_MUTE_FAVORITE_EVENTS. Subject = the actor.",
  "type": "object",
  "properties": {
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "actor_id",
    "target_id",
    "occurred_at"
  ],
  "additionalProperties": false
}
