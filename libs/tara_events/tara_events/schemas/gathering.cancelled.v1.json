{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tara.local/events/gathering.cancelled.v1.json",
  "title": "gathering.cancelled v1 payload",
  "description": "The host cancelled an event. recipients: going and interested accounts, in chunks of at most 500.",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string",
      "format": "uuid"
    },
    "host_id": {
      "type": "string",
      "format": "uuid"
    },
    "host_type": {
      "type": "string",
      "enum": [
        "user",
        "page"
      ]
    },
    "audience": {
      "type": "string",
      "enum": [
        "public",
        "friends",
        "invite_only",
        "group"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "cancelled",
        "ended"
      ]
    },
    "location_type": {
      "type": "string",
      "enum": [
        "place",
        "online"
      ]
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "capacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "cover_media_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "maxItems": 500
    },
    "chunk": {
      "type": "integer",
      "minimum": 0
    },
    "chunks": {
      "type": "integer",
      "minimum": 1
    },
    "group_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Set for an event in a group (1.11, additive): its audience is then group."
    }
  },
  "required": [
    "gathering_id",
    "host_id",
    "host_type",
    "audience",
    "status",
    "location_type",
    "starts_at",
    "ends_at",
    "capacity",
    "cover_media_id",
    "recipients",
    "chunk",
    "chunks"
  ],
  "additionalProperties": false
}
