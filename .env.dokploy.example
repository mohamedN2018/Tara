# SUPERSEDED: the full reference is .env_prod.example, and the generator now
# writes .env_prod. Kept for deployments generated before 2026-11-04.
# Dokploy production env — structure reference.
# DO NOT fill secrets here and commit. Generate a real one with:
#
#     ./scripts/gen-dokploy-env.sh your-domain.com
#
# …then paste its output into Dokploy's service "Environment" panel (or keep the
# generated .env next to the compose file). The generator fills every value below
# with strong random secrets. Only DOMAIN is yours to choose.

DOMAIN=your-domain.com            # the public hostname (A record → your server)
TARA_ENV=production

# Generated by the script (one per service; shown here as placeholders):
POSTGRES_SUPERUSER=tara
POSTGRES_SUPERUSER_PASSWORD=__GENERATED__
RABBITMQ_USER=tara
RABBITMQ_PASS=__GENERATED__
MINIO_ROOT_USER=tara
MINIO_ROOT_PASSWORD=__GENERATED__
INTERNAL_JWT_SECRET=__GENERATED__
ADMIN_IDENTITY_SECRET=__GENERATED__
CHAT_IDENTITY_SECRET=__GENERATED__
ADS_SERVE_TOKEN_SECRET=__GENERATED__
ADS_SERVING_ENABLED=false

# Per-service: *_DB_NAME/_USER/_PASSWORD, *_SECRET_KEY, *_DEBUG=false,
# *_ALLOWED_HOSTS=*  — see scripts/gen-dokploy-env.sh for the full list.
#
# To pass `manage.py check --deploy` strictly, replace *_ALLOWED_HOSTS=* with
# your domain + service names. For a running demo, * is fine (traffic only ever
# reaches services through the nginx edge).

# Calls (LiveKit). The generator sets COMPOSE_PROFILES=calls (starts the livekit
# container) and generates the key and secret; see docs/deploy/DOKPLOY.md,
# "Calls (LiveKit)", for the firewall ports. Empty key/secret: calls off.
COMPOSE_PROFILES=calls
LIVEKIT_API_KEY=__GENERATED__
LIVEKIT_API_SECRET=__GENERATED__
LIVEKIT_URL=wss://your-domain.com
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_NODE_IP=                  # the server's public IP; empty: found over STUN
LIVEKIT_TURN_DOMAIN=your-domain.com
