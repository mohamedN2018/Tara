# =============================================================================
# Tara — PRODUCTION environment template.
#
# This file documents EVERY variable a production deployment must set. It is a
# template, not a usable config: every secret is a `__REPLACE_ME__` placeholder.
# Do NOT fill secrets here and commit them — source them from a secret manager
# (External Secrets Operator / Sealed Secrets / SOPS / Vault) and inject at
# deploy time. The tara_common production-safety deploy check (tara.E001..E006)
# REJECTS any leftover `REPLACE_ME` / dev-default value when DEBUG=false, so a
# half-configured deploy fails fast instead of running insecurely.
#
# Differences from .env.example (dev): TARA_ENV=production, every *_DEBUG=false,
# every *_ALLOWED_HOSTS pinned (no '*'), CORS pinned to real origins, and all
# secrets are placeholders.
# =============================================================================

# ---- Global ----------------------------------------------------------------
TARA_ENV=production
TZ=UTC
COMPOSE_PROJECT_NAME=tara

# ---- PostgreSQL (managed instance; one logical DB per service) --------------
POSTGRES_HOST=__REPLACE_ME__.db.internal
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=tara_admin
POSTGRES_SUPERUSER_PASSWORD=__REPLACE_ME__

# Per-service DB credentials (least-privilege; one role per service)
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=__REPLACE_ME__
PROFILE_DB_NAME=profile_db
PROFILE_DB_USER=profile
PROFILE_DB_PASSWORD=__REPLACE_ME__
GRAPH_DB_NAME=graph_db
GRAPH_DB_USER=graph
GRAPH_DB_PASSWORD=__REPLACE_ME__
MEDIA_DB_NAME=media_db
MEDIA_DB_USER=media
MEDIA_DB_PASSWORD=__REPLACE_ME__
POST_DB_NAME=post_db
POST_DB_USER=post
POST_DB_PASSWORD=__REPLACE_ME__
FEED_DB_NAME=feed_db
FEED_DB_USER=feed
FEED_DB_PASSWORD=__REPLACE_ME__
CHAT_DB_NAME=chat_db
CHAT_DB_USER=chat
CHAT_DB_PASSWORD=__REPLACE_ME__
MARKET_DB_NAME=market_db
MARKET_DB_USER=market
MARKET_DB_PASSWORD=__REPLACE_ME__
NOTIF_DB_NAME=notif_db
NOTIF_DB_USER=notif
NOTIF_DB_PASSWORD=__REPLACE_ME__
SEARCH_DB_NAME=search_db
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=__REPLACE_ME__
MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation
MODERATION_DB_PASSWORD=__REPLACE_ME__
ADMIN_DB_NAME=admin_db
ADMIN_DB_USER=adminsvc
ADMIN_DB_PASSWORD=__REPLACE_ME__
ADS_DB_NAME=ads_db
ADS_DB_USER=ads
ADS_DB_PASSWORD=__REPLACE_ME__

# ---- Redis (managed; TLS) ---------------------------------------------------
REDIS_URL=rediss://:__REPLACE_ME__@redis.internal:6379/0

# ---- RabbitMQ (managed; TLS) ------------------------------------------------
RABBITMQ_DEFAULT_USER=tara
RABBITMQ_DEFAULT_PASS=__REPLACE_ME__
RABBITMQ_URL=amqps://tara:__REPLACE_ME__@rabbitmq.internal:5671//
TARA_EVENT_EXCHANGE=tara.events

# ---- Object storage (S3) ----------------------------------------------------
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=__REPLACE_ME__
S3_USE_SSL=true
S3_BUCKET=tara-media-prod
S3_PUBLIC_BASE=https://cdn.tara.example
TARA_STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=__REPLACE_ME__
AWS_SECRET_ACCESS_KEY=__REPLACE_ME__

# ---- Mail (real SMTP) -------------------------------------------------------
EMAIL_HOST=__REPLACE_ME__.smtp.internal
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=__REPLACE_ME__
EMAIL_HOST_PASSWORD=__REPLACE_ME__
DEFAULT_FROM_EMAIL=no-reply@tara.example

# ---- Per-service Django secrets (one strong, unique value EACH) -------------
IDENTITY_SECRET_KEY=__REPLACE_ME__
PROFILE_SECRET_KEY=__REPLACE_ME__
GRAPH_SECRET_KEY=__REPLACE_ME__
MEDIA_SECRET_KEY=__REPLACE_ME__
POST_SECRET_KEY=__REPLACE_ME__
FEED_SECRET_KEY=__REPLACE_ME__
CHAT_SECRET_KEY=__REPLACE_ME__
REALTIME_SECRET_KEY=__REPLACE_ME__
MARKETPLACE_SECRET_KEY=__REPLACE_ME__
NOTIFICATION_SECRET_KEY=__REPLACE_ME__
SEARCH_SECRET_KEY=__REPLACE_ME__
MODERATION_SECRET_KEY=__REPLACE_ME__
ADMIN_SECRET_KEY=__REPLACE_ME__
ADS_SECRET_KEY=__REPLACE_ME__

# Internal service-to-service token signing secret (shared verification secret)
INTERNAL_JWT_SECRET=__REPLACE_ME__
# Only admin may call identity's internal role/staff endpoints, with this key
# (never the shared internal secret). Must differ from INTERNAL_JWT_SECRET.
ADMIN_IDENTITY_SECRET=__REPLACE_ME__
# Signs ad serve tokens; only the ads service holds it.
ADS_SERVE_TOKEN_SECRET=__REPLACE_ME__
# Paid ads stay off until payment verification exists (roadmap 6.3).
ADS_SERVING_ENABLED=false

# ---- Debug OFF everywhere ---------------------------------------------------
IDENTITY_DEBUG=false
PROFILE_DEBUG=false
GRAPH_DEBUG=false
MEDIA_DEBUG=false
POST_DEBUG=false
FEED_DEBUG=false
CHAT_DEBUG=false
REALTIME_DEBUG=false
MARKETPLACE_DEBUG=false
NOTIFICATION_DEBUG=false
SEARCH_DEBUG=false
MODERATION_DEBUG=false
ADMIN_DEBUG=false
ADS_DEBUG=false

# ---- Allowed hosts pinned (NO '*') ------------------------------------------
IDENTITY_ALLOWED_HOSTS=api.tara.example,identity.tara.svc.cluster.local
# (set the equivalent *_ALLOWED_HOSTS for every other service)

# ---- CORS pinned to real origins --------------------------------------------
IDENTITY_CORS_ORIGINS=https://app.tara.example
BFF_ALLOWED_ORIGINS=https://app.tara.example

# ---- Identity JWT (RS256) — inject PEMs from the secret manager -------------
IDENTITY_JWT_PRIVATE_KEY=__REPLACE_ME__
IDENTITY_JWT_PUBLIC_KEY=__REPLACE_ME__
IDENTITY_JWT_KEY_ID=__REPLACE_ME__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
JWT_ISSUER=tara-identity
JWT_AUDIENCE=tara
TARA_JWKS_URL=https://api.tara.example/.well-known/jwks.json

# ---- Cross-service internal URLs --------------------------------------------
GRAPH_INTERNAL_URL=http://graph.tara.svc.cluster.local:8000
ADS_INTERNAL_URL=http://ads.tara.svc.cluster.local:8000
BFF_IDENTITY_BASE_URL=http://identity.tara.svc.cluster.local:8000
BFF_JWKS_URL=http://identity.tara.svc.cluster.local:8000/.well-known/jwks.json

# ---- Moderation / Ads review (no silent auto-approve in prod) ---------------
MARKETPLACE_AUTO_APPROVE=false
ADS_AUTO_APPROVE=false

# ---- Search (OpenSearch enabled in prod) ------------------------------------
SEARCH_USE_OPENSEARCH=true
OPENSEARCH_URL=https://opensearch.internal:9200

# ---- Observability ----------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring:4317
LOG_LEVEL=INFO
LOG_FORMAT=json
# Web Push. Generate with: python -m py_vapid --gen (leave empty to turn push off)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
