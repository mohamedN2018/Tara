# Normalize line endings: keep LF in the repo, let Git handle checkout per-OS.
* text=auto eol=lf

# Shell scripts and Dockerfiles MUST stay LF even on Windows checkouts
# (CRLF breaks container entrypoints).
*.sh        text eol=lf
*.bash      text eol=lf
entrypoint* text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf

# Windows-specific scripts stay CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Treat these as binary (never normalize / never diff)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.mp4  binary
*.webm binary
*.mp3  binary
*.wav  binary
